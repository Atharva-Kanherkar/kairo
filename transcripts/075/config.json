{
  "$schema": "https://www.getbifrost.ai/schema",
  "providers": {
    "gemini": {
      "keys": [
        {
          "name": "gemini-key",
          "value": "env.GEMINI_API_KEY",
          "models": [
            "*"
          ]
        }
      ],
      "send_back_raw_request": true,
      "send_back_raw_response": true,
      "network_config": {
        "default_request_timeout_in_seconds": 120
      }
    }
  }
}
