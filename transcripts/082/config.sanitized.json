{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "disable_content_logging": false,
    "enable_logging": true,
    "initial_pool_size": 10
  },
  "config_store": {
    "config": {
      "path": "<RUNTIME_DIR>/config.db"
    },
    "enabled": true,
    "type": "sqlite"
  },
  "logs_store": {
    "enabled": false
  },
  "mcp": {
    "client_configs": [
      {
        "auth_type": "none",
        "client_id": "kairo-side-effect-082",
        "connection_string": "http://127.0.0.1:51687/mcp",
        "connection_type": "http",
        "is_ping_available": false,
        "name": "KairoSideEffect",
        "needs_session_stickiness": true,
        "tools_to_auto_execute": [
          "charge",
          "credit"
        ],
        "tools_to_execute": [
          "*"
        ]
      }
    ],
    "tool_manager_config": {
      "max_agent_depth": 5,
      "tool_execution_timeout": "5s"
    }
  },
  "providers": {
    "mockoai": {
      "custom_provider_config": {
        "base_provider_type": "openai"
      },
      "keys": [
        {
          "models": [
            "*"
          ],
          "name": "kairo-synthetic",
          "value": "<SYNTHETIC_PROVIDER_KEY>",
          "weight": 1
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:51686"
      }
    }
  }
}
