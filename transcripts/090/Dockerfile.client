FROM public.ecr.aws/docker/library/python:3.13-slim@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b

RUN pip install --no-cache-dir websockets==15.0.1 \
    && cp /usr/local/bin/python3.13 /usr/local/bin/tool-a \
    && cp /usr/local/bin/python3.13 /usr/local/bin/tool-b

CMD ["sleep", "infinity"]
