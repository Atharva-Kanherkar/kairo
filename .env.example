# kairo, provider keys for CAPTURE runs only.
# Replay tests never touch the network; these are read once when recording
# golden transcripts. Fill in your real keys. This file is gitignored.

# ── the four you have ────────────────────────────────────────────────
OPENAI_API_KEY=sk-REPLACE_ME
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
GEMINI_API_KEY=REPLACE_ME
OPENROUTER_API_KEY=sk-or-REPLACE_ME

# ── optional extras, uncomment as you get them ───────────────────────
# GROQ_API_KEY=
# FIREWORKS_API_KEY=
# TOGETHER_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# COHERE_API_KEY=

# ── local targets (no keys needed) ───────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLAMACPP_BASE_URL=http://localhost:8080
# VLLM_BASE_URL=http://localhost:8000

# ── tools under test (spin up locally, defaults fine) ────────────────
LITELLM_BASE_URL=http://localhost:4000
SWITCHYARD_BASE_URL=http://localhost:9000
BIFROST_BASE_URL=http://localhost:8090
