 	echo := extra
 	return &echo
 }
+
+// responsesOutputHasRefusal reports whether any output message carries a refusal part.
+func responsesOutputHasRefusal(output []schemas.ResponsesMessage) bool {
+	for _, item := range output {
+		if item.Content == nil {
+			continue
+		}
+		for _, block := range item.Content.ContentBlocks {
+			if block.Type == schemas.ResponsesOutputMessageContentTypeRefusal {
+				return true
+			}
+		}
+	}
+	return false
+}
