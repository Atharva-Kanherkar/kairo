 // Helper function to convert ContentBlock to AnthropicContentBlock
 func convertContentBlockToAnthropic(block schemas.ResponsesMessageContentBlock) *AnthropicContentBlock {
 	switch block.Type {
+	case schemas.ResponsesOutputMessageContentTypeRefusal:
+		// Anthropic has no refusal content type; the refusal is ordinary assistant text,
+		// and ToAnthropicResponsesResponse reports stop_reason "refusal" for it.
