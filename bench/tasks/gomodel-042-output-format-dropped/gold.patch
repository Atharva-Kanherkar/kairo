--- a/internal/anthropicapi/request.go
+++ b/internal/anthropicapi/request.go
@@ -550,9 +550,47 @@ func buildExtraFields(req *MessagesRequest) core.UnknownJSONFields {
 	if raw := bytes.TrimSpace(req.CacheControl); len(raw) > 0 && !core.IsJSONNull(raw) {
 		fields["cache_control"] = core.CloneRawJSON(raw)
 	}
+	if raw, ok := structuredOutputResponseFormat(req); ok {
