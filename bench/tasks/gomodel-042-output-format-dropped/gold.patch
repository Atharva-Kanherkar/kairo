 	return core.UnknownJSONFieldsFromMap(fields)
 }
 
+// structuredOutputResponseFormat maps Anthropic structured output (output_config.format,
+// or the top-level output_format spelling) onto an OpenAI json_schema response_format.
+func structuredOutputResponseFormat(req *MessagesRequest) (json.RawMessage, bool) {
+	var format struct {
+		Type   string          `json:"type"`
+		Schema json.RawMessage `json:"schema"`
+	}
+	var config struct {
+		Format json.RawMessage `json:"format"`
+	}
+	raw := bytes.TrimSpace(req.OutputFormat)
+	if cfg := bytes.TrimSpace(req.OutputConfig); len(cfg) > 0 && !core.IsJSONNull(cfg) {
+		if err := json.Unmarshal(cfg, &config); err == nil && len(bytes.TrimSpace(config.Format)) > 0 {
+			raw = bytes.TrimSpace(config.Format)
+		}
+	}
+	if len(raw) == 0 || core.IsJSONNull(raw) {
+		return nil, false
+	}
+	if err := json.Unmarshal(raw, &format); err != nil || format.Type != "json_schema" || len(format.Schema) == 0 {
+		return nil, false
+	}
+	out, err := json.Marshal(map[string]any{
+		"type": "json_schema",
+		"json_schema": map[string]any{
+			"name":   "output",
+			"schema": format.Schema,
+		},
+	})
+	if err != nil {
+		return nil, false
+	}
+	return out, true
+}
