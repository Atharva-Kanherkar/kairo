# Keys for the agents under test. Only the names an agent lists in agents.toml
# are passed into its container, as environment variables, never on a command
# line. Leave a line empty to skip agents that need it. bench/.env and the
# repository-root .env are both read; real environment variables win.

# Claude Code (either one), OpenCode and mini-SWE-agent with anthropic/* models
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# OpenAI Codex CLI, OpenCode and mini-SWE-agent with openai/* models
OPENAI_API_KEY=

# Gemini CLI, OpenCode and mini-SWE-agent with gemini/* models
GEMINI_API_KEY=

# OpenCode and mini-SWE-agent with openrouter/* models
OPENROUTER_API_KEY=
